datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String                   @id @default(uuid())
  email               String                   @unique
  name                String
  phone               String?
  passwordHash        String
  role                String                   @default("user") // "admin" | "user"
  emailVerified       Boolean                  @default(false)
  phoneVerified       Boolean                  @default(false)
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  status              String                   @default("unverified") // "unverified" | "active" | "suspended"
  failedLoginAttempts Int                      @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  lastLoginAt         DateTime?
  registrationIp      String?
  lastLoginIp         String?
  city                String?
  region              String?                  // State / Province (e.g. Maharashtra, California)
  country             String?                  // Country Name (e.g. India, United States)
  countryCode         String?                  // 2-Letter Code (e.g. IN, US)
  timezone            String?                  // e.g. Asia/Kolkata
  userAgent           String?                  // Device / Browser metadata
  org                 String?                  // ISP / Org
  apiKeys             ApiKey[]
  apiRequests         ApiRequest[]
  adminLogs           AdminLog[]
  orders              Order[]
  tokenLedgers        TokenLedger[]
  trialClaims         TrialClaim[]
  supportTickets      SupportTicket[]
  ticketMessages      TicketMessage[]
  emailTokens         EmailVerificationToken[]
  phoneOtps           PhoneOtpCode[]
  passwordResetTokens PasswordResetToken[]
  userSessions        UserSession[]
  securityLogs        SecurityLog[]
  notifications       Notification[]
  subscriptions       Subscription[]
}


model ApiKey {
  id                String        @id @default(uuid())
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyPrefix         String        // "ld_live_" or "ld_trial_"
  keyHash           String        @unique
  displayKey        String
  name              String
  type              String        @default("production") // "production" | "trial"
  status            String        @default("active") // "active" | "suspended" | "revoked"
  purchasedTokens   BigInt        @default(1000000)
  tokensUsed        BigInt        @default(0)
  tokensRemaining   BigInt        @default(1000000)
  expiresAt         DateTime?
  rateLimitRpm      Int           @default(60)
  maxConcurrency    Int           @default(5)
  totalRequests     Int           @default(0)
  totalInputTokens  BigInt        @default(0)
  totalOutputTokens BigInt        @default(0)
  allowedModels     String        @default("all")
  plan              String        @default("Prepaid")
  firstUsedAt       DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime      @default(now())

  updatedAt         DateTime      @updatedAt
  requests          ApiRequest[]
  tokenLedgers      TokenLedger[]
  trialClaims       TrialClaim[]
  subscriptions     Subscription[]
}

model ApiRequest {
  id           String    @id @default(uuid())
  apiKeyId     String?
  apiKey       ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  model        String
  endpoint     String
  requestId    String    @unique @default(uuid())
  statusCode   Int       @default(200)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  totalTokens  Int       @default(0)
  latencyMs    Int       @default(0)
  streaming    Boolean   @default(false)
  providerId   String?
  errorCode    String?
  errorMessage String?
  isEstimated  Boolean   @default(false)
  usageSource  String    @default("PROVIDER_REPORTED") // "PROVIDER_REPORTED" | "LOCAL_CALCULATED" | "SIMULATED_ESTIMATE"
  createdAt    DateTime  @default(now())

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}



model VendorProvider {
  id                     String              @id @default(uuid())
  name                   String
  providerType           String              @default("anthropic") // "anthropic" | "openai" | "custom_http"
  protocol               String              @default("anthropic") // "anthropic" | "openai-compatible" | "custom_http"
  masterApiKeyEncrypted   String              @default("")
  baseUrl                String              @default("https://api.anthropic.com")
  status                 String              @default("connected") // "connected" | "invalid_credential" | "ssrf_blocked" | "timeout" | "rate_limited" | "provider_error" | "disabled"
  isPrimary              Boolean             @default(true)
  availableTokens        BigInt              @default(0)
  purchasedTokens        BigInt              @default(0)

  consumedTokens         BigInt              @default(0)
  reservedTokens         BigInt              @default(0)
  warningThresholdTokens BigInt              @default(20000000)
  criticalThresholdTokens BigInt             @default(5000000)
  modelMappingsJson      String?             // JSON string for internal -> vendor model mappings
  headersJson            String?             // JSON string for custom HTTP headers
  lastTestedAt           DateTime?
  lastError              String?
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  masterTokenLedgers     MasterTokenLedger[]
}

model MasterTokenLedger {
  id           String         @id @default(uuid())
  providerId   String
  provider     VendorProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type         String         // "INITIAL_ALLOCATION" | "TOP_UP" | "CUSTOMER_USAGE" | "ADJUSTMENT" | "REFUND" | "REVERSAL"
  amount       BigInt
  balanceAfter BigInt
  reference    String?
  notes        String?
  adminUserId  String?
  apiKeyId     String?
  userId       String?
  createdAt    DateTime       @default(now())
}



model TokenPackage {
  id          String   @id @default(uuid())
  tokenAmount BigInt
  priceInr    Float
  displayName String
  description String?
  featured    Boolean  @default(false)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id                String        @id @default(uuid())
  internalOrderId   String        @unique @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId         String?
  package           TokenPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  planId            String        @default("plan_5m_5h")
  planName          String        @default("Claude Max 5x")
  tokenQuantity     BigInt        @default(5000000)
  windowHours       Int           @default(5)
  amountInr         Float
  paidAmountInr     Float?
  currency          String        @default("INR")
  status            String        @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "CANCELLED" (Legacy compatibility)
  paymentStatus     String        @default("CREATED") // CREATED, PENDING, PROCESSING, AUTHORIZED, CAPTURED, FAILED, CANCELLED, REFUNDED, VERIFICATION_FAILED
  fulfillmentStatus String        @default("NOT_FULFILLED") // NOT_FULFILLED, FULFILLMENT_PENDING, FULFILLED, FULFILLMENT_FAILED, RETRY_REQUIRED
  paymentGateway    String        @default("TEST")
  paymentReference  String?
  gatewayOrderId    String?
  gatewayPaymentId  String?
  gatewaySignature  String?
  fulfilledApiKeyId String?
  failureReason     String?
  tokensCredited    Boolean       @default(false)
  paidAt            DateTime?
  fulfilledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  subscriptions     Subscription[]

  @@index([userId, createdAt])
  @@index([paymentStatus])
}

model PaymentEvent {
  id               String   @id @default(uuid())
  eventId          String   @unique
  provider         String
  eventType        String
  payloadHash      String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  processedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
}

model TokenLedger {
  id           String   @id @default(uuid())
  apiKeyId     String?
  apiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       BigInt
  balanceAfter BigInt
  type         String   // "PURCHASE" | "USAGE" | "ADMIN_ADJUSTMENT" | "TRIAL_GRANT"
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
}

model TrialClaim {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  ipAddress  String
  deviceHash String?
  riskScore  Float    @default(0.0)
  decision   String   @default("APPROVED") // "APPROVED" | "REJECTED" | "NEEDS_VERIFICATION"
  apiKeyId   String?
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String    // "free_trial", "pro", "max", "ultra"
  planName         String    // "Free Trial", "PRO", "MAX", "ULTRA"
  orderId          String?
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  apiKeyId         String?
  apiKey           ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  activationTime   DateTime  @default(now())
  expiryTime       DateTime
  quotaLimit       BigInt    @default(5000000)
  quotaWindowHours Int       @default(5)
  currentUsage     BigInt    @default(0)
  nextResetTime    DateTime
  status           String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "SUSPENDED" | "CANCELLED"
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
}

model Plan {
  id              String   @id @default(uuid())
  name            String   @unique
  displayName     String
  tokenAllowance  BigInt   @default(20000000)
  windowHours     Int      @default(5)
  validityDays    Int      @default(30)
  rateLimitRpm    Int      @default(60)
  status          String   @default("active") // "active" | "archived"
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Model {

  id                String   @id @default(uuid())
  modelId           String   @unique
  displayName       String
  provider          String   // "Anthropic" | "OpenAI" | "Google" | "xAI" | "DeepSeek"
  description       String
  contextWindow     Int      @default(1000000)
  enabled           Boolean  @default(true)
  inputPrice        Float    @default(3.0)
  outputPrice       Float    @default(15.0)
  supportsStreaming Boolean  @default(true)
  supportsTools     Boolean  @default(true)
  supportsVision    Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminLog {
  id          String   @id @default(uuid())
  adminUserId String?
  adminUser   User?    @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String?
  metadata    String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Lead {
  id          String   @id @default(uuid())
  name        String
  email       String
  tokenAmount String
  useCase     String?
  message     String?
  status      String   @default("NEW") // "NEW" | "CONTACTED" | "QUOTED" | "CONVERTED" | "CLOSED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String
  category      String          @default("Technical issue") // "API issue" | "Payment" | "API key" | "Account" | "Technical issue" | "Other"
  status        String          @default("Open") // "Open" | "Awaiting Customer" | "Awaiting Support" | "Resolved" | "Closed"
  priority      String          @default("Normal") // "Low" | "Normal" | "High" | "Urgent"
  assignedAdmin String?
  messages      TicketMessage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole  String        @default("user") // "user" | "admin"
  content     String
  createdAt   DateTime      @default(now())
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  resendCount Int       @default(0)
  lastSentAt  DateTime  @default(now())
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
}

model PhoneOtpCode {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String
  otpHash     String
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  resendCount Int       @default(0)
  lastSentAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique
  ipAddress        String
  userAgent        String
  device           String
  location         String?
  isRevoked        Boolean   @default(false)
  expiresAt        DateTime
  lastActiveAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  ipAddress String?
  userAgent String?
  eventType String   // "REGISTER" | "EMAIL_VERIFICATION_SENT" | "EMAIL_VERIFIED" | "PHONE_OTP_SENT" | "PHONE_VERIFIED" | "LOGIN_SUCCESS" | "LOGIN_FAILED" | "LOGIN_LOCKED" | "LOGOUT" | "PASSWORD_RESET_REQUESTED" | "PASSWORD_RESET_COMPLETED" | "PASSWORD_CHANGED" | "SESSION_REVOKED" | "ADMIN_LOGIN_SUCCESS" | "ADMIN_LOGIN_FAILED" | "ACCOUNT_SUSPENDED"
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email])
  @@index([eventType])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // "info" | "success" | "warning" | "error"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AuditEvent {
  id              String    @id @default(uuid())
  timestamp       DateTime  @default(now())
  eventType       String    // e.g. "LOGIN_SUCCESS", "POSSIBLE_SQL_INJECTION_ATTEMPT", "ORDER_CREATED", etc.
  severity        String    @default("INFO") // "INFO" | "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  actorType       String    @default("SYSTEM") // "CUSTOMER" | "ADMIN" | "API_KEY" | "SYSTEM" | "ANONYMOUS" | "PAYMENT_PROVIDER" | "SUPPLIER"
  actorId         String?
  actorEmail      String?
  customerId      String?
  adminId         String?
  apiKeyId        String?
  sessionId       String?
  requestId       String?
  endpoint        String?
  httpMethod      String?
  resourceType    String?   // "USER" | "API_KEY" | "ORDER" | "SUBSCRIPTION" | "SUPPORT_TICKET" | "SUPPLIER" | "PLAN" | "SYSTEM"
  resourceId      String?
  action          String?
  result          String    @default("SUCCESS") // "SUCCESS" | "BLOCKED" | "FAILED" | "DENIED" | "WARNING"
  statusCode      Int?
  ipAddress       String?
  userAgent       String?
  country         String?
  metadata        String?   // Safe JSON metadata
  failureReason   String?
  beforeState     String?   // JSON snapshot before change
  afterState      String?   // JSON snapshot after change
  tamperHash      String?   // SHA-256 hash for tamper evidence
  previousHash    String?   // Previous record SHA-256 hash
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?

  @@index([timestamp])
  @@index([eventType])
  @@index([severity])
  @@index([actorType, actorId])
  @@index([customerId])
  @@index([adminId])
  @@index([apiKeyId])
  @@index([requestId])
  @@index([ipAddress])
  @@index([resourceType, resourceId])
  @@index([isResolved])
}



