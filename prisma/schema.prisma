datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String                   @id @default(uuid())
  email               String                   @unique
  name                String
  phone               String?
  passwordHash        String
  role                String                   @default("user") // "admin" | "user"
  emailVerified       Boolean                  @default(false)
  phoneVerified       Boolean                  @default(false)
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  status              String                   @default("unverified") // "unverified" | "active" | "suspended"
  failedLoginAttempts Int                      @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  lastLoginAt         DateTime?
  registrationIp      String?
  lastLoginIp         String?
  city                String?
  region              String?                  // State / Province (e.g. Maharashtra, California)
  country             String?                  // Country Name (e.g. India, United States)
  countryCode         String?                  // 2-Letter Code (e.g. IN, US)
  timezone            String?                  // e.g. Asia/Kolkata
  userAgent           String?                  // Device / Browser metadata
  org                 String?                  // ISP / Org
  apiKeys             ApiKey[]
  apiRequests         ApiRequest[]
  adminLogs           AdminLog[]
  orders              Order[]
  tokenLedgers        TokenLedger[]
  trialClaims         TrialClaim[]
  supportTickets      SupportTicket[]
  ticketMessages      TicketMessage[]
  emailTokens         EmailVerificationToken[]
  phoneOtps           PhoneOtpCode[]
  passwordResetTokens PasswordResetToken[]
  userSessions        UserSession[]
  securityLogs        SecurityLog[]
  notifications       Notification[]
  notificationPreference NotificationPreference?
  subscriptions       Subscription[]
  couponUsages        CouponUsage[]
  availableCredits        Float                    @default(0)
  lifetimeCreditsEarned   Float                    @default(0)
  lifetimeCreditsRedeemed Float                    @default(0)
  creditTransactions      CreditTransaction[]
  purchases               Purchase[]
  referralCode            String?                  @unique
  referralsGiven          Referral[]               @relation("ReferrerUser")
  referralReceived        Referral?                @relation("ReferredUser")
  whatsappConversations   WhatsAppConversation[]   @relation("WhatsAppCustomer")
  assignedWhatsAppConversations WhatsAppConversation[] @relation("AssignedAdminWhatsApp")
  whatsappIdentities      WhatsAppCustomerIdentity[]
  negotiatedPrices        NegotiatedPrice[]
}


model ApiKey {
  id                String        @id @default(uuid())
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyPrefix         String        // "ld_live_" or "ld_trial_"
  keyHash           String        @unique
  displayKey        String
  keyEncrypted      String?
  name              String
  type              String        @default("production") // "production" | "trial"
  status            String        @default("active") // "active" | "suspended" | "revoked"
  purchasedTokens   BigInt        @default(1000000)
  tokensUsed        BigInt        @default(0)
  tokensRemaining   BigInt        @default(1000000)
  expiresAt         DateTime?
  rateLimitRpm      Int           @default(60)
  maxConcurrency    Int           @default(5)
  totalRequests     Int           @default(0)
  totalInputTokens  BigInt        @default(0)
  totalOutputTokens BigInt        @default(0)
  allowedModels     String        @default("all")
  plan              String        @default("Prepaid")
  firstUsedAt       DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime      @default(now())

  updatedAt         DateTime      @updatedAt
  requests          ApiRequest[]
  tokenLedgers      TokenLedger[]
  trialClaims       TrialClaim[]
  subscriptions     Subscription[]
}

model ApiRequest {
  id           String    @id @default(uuid())
  apiKeyId     String?
  apiKey       ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  model        String
  endpoint     String
  requestId    String    @unique @default(uuid())
  statusCode   Int       @default(200)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  totalTokens  Int       @default(0)
  latencyMs    Int       @default(0)
  streaming    Boolean   @default(false)
  providerId   String?
  errorCode    String?
  errorMessage String?
  isEstimated  Boolean   @default(false)
  usageSource  String    @default("PROVIDER_REPORTED") // "PROVIDER_REPORTED" | "LOCAL_CALCULATED" | "SIMULATED_ESTIMATE"
  createdAt    DateTime  @default(now())

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}



model VendorProvider {
  id                     String              @id @default(uuid())
  name                   String
  providerType           String              @default("anthropic") // "anthropic" | "openai" | "custom_http"
  protocol               String              @default("anthropic") // "anthropic" | "openai-compatible" | "custom_http"
  masterApiKeyEncrypted   String              @default("")
  baseUrl                String              @default("https://api.anthropic.com")
  status                 String              @default("connected") // "connected" | "invalid_credential" | "ssrf_blocked" | "timeout" | "rate_limited" | "provider_error" | "disabled"
  isPrimary              Boolean             @default(true)
  availableTokens        BigInt              @default(0)
  purchasedTokens        BigInt              @default(0)

  consumedTokens         BigInt              @default(0)
  reservedTokens         BigInt              @default(0)
  warningThresholdTokens BigInt              @default(20000000)
  criticalThresholdTokens BigInt             @default(5000000)
  modelMappingsJson      String?             // JSON string for internal -> vendor model mappings
  headersJson            String?             // JSON string for custom HTTP headers
  lastTestedAt           DateTime?
  lastError              String?
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  masterTokenLedgers     MasterTokenLedger[]
}

model MasterTokenLedger {
  id           String         @id @default(uuid())
  providerId   String
  provider     VendorProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type         String         // "INITIAL_ALLOCATION" | "TOP_UP" | "CUSTOMER_USAGE" | "ADJUSTMENT" | "REFUND" | "REVERSAL"
  amount       BigInt
  balanceAfter BigInt
  reference    String?
  notes        String?
  adminUserId  String?
  apiKeyId     String?
  userId       String?
  createdAt    DateTime       @default(now())
}



model TokenPackage {
  id          String   @id @default(uuid())
  tokenAmount BigInt
  priceInr    Float
  displayName String
  description String?
  featured    Boolean  @default(false)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id                String        @id @default(uuid())
  internalOrderId   String        @unique @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId         String?
  package           TokenPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  planId            String        @default("plan_5m_5h")
  planName          String        @default("Claude Max 5x")
  tokenQuantity     BigInt        @default(5000000)
  windowHours       Int           @default(5)
  amountInr         Float
  originalAmountInr Float?
  discountAmountInr Float?        @default(0)
  couponCode        String?
  paidAmountInr     Float?
  currency          String        @default("INR")
  status            String        @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "CANCELLED" (Legacy compatibility)
  paymentStatus     String        @default("CREATED") // CREATED, PENDING, PROCESSING, AUTHORIZED, CAPTURED, FAILED, CANCELLED, REFUNDED, VERIFICATION_FAILED
  fulfillmentStatus String        @default("NOT_FULFILLED") // NOT_FULFILLED, FULFILLMENT_PENDING, FULFILLED, FULFILLMENT_FAILED, RETRY_REQUIRED
  paymentGateway    String        @default("TEST")
  paymentReference  String?
  gatewayOrderId    String?
  gatewayPaymentId  String?
  gatewaySignature  String?
  fulfilledApiKeyId String?
  failureReason     String?
  fulfillmentNotes  String?
  fulfillmentAttempts Int         @default(0)
  lastFulfillmentAttemptAt DateTime?
  nextRetryAt       DateTime?
  fulfillmentChannel String?      // "API_KEY" | "INVENTORY" | "MANUAL"
  subscriptionId    String?       // Linked subscription if this is a renewal
  slaPriority       String        @default("NORMAL") // "LOW" | "NORMAL" | "HIGH" | "URGENT"
  channel           String        @default("WEBSITE") // "WEBSITE" | "WHATSAPP" | "MANUAL"
  priceSource       String        @default("STANDARD") // "STANDARD" | "ADMIN_NEGOTIATED"
  whatsappConversationId String?
  whatsappConversation   WhatsAppConversation? @relation(fields: [whatsappConversationId], references: [id], onDelete: SetNull)
  negotiatedPrice        NegotiatedPrice?
  tokensCredited    Boolean       @default(false)
  paidAt            DateTime?
  fulfilledAt       DateTime?
  creditsEarned     Float?        @default(0)
  creditsRedeemed   Float?        @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  subscriptions     Subscription[]
  creditTransactions CreditTransaction[]
  purchases         Purchase[]
  referrals         Referral[]
  activeForConversations WhatsAppConversation[] @relation("ConversationActiveOrder")

  @@index([userId, createdAt])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([subscriptionId])
  @@index([channel])
  @@index([whatsappConversationId])
}

model PaymentEvent {
  id               String   @id @default(uuid())
  eventId          String   @unique
  provider         String
  eventType        String
  payloadHash      String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  processedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
}

model TokenLedger {
  id           String   @id @default(uuid())
  apiKeyId     String?
  apiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       BigInt
  balanceAfter BigInt
  type         String   // "PURCHASE" | "USAGE" | "ADMIN_ADJUSTMENT" | "TRIAL_GRANT"
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
}

model TrialClaim {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  ipAddress  String
  deviceHash String?
  riskScore  Float    @default(0.0)
  decision   String   @default("APPROVED") // "APPROVED" | "REJECTED" | "NEEDS_VERIFICATION"
  apiKeyId   String?
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String    // "free_trial", "pro", "max", "ultra"
  planName         String    // "Free Trial", "PRO", "MAX", "ULTRA"
  orderId          String?
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  apiKeyId         String?
  apiKey           ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  activationTime   DateTime  @default(now())
  expiryTime       DateTime
  durationDays     Int       @default(30)
  renewalCount     Int       @default(0)
  autoRenewEnabled Boolean   @default(false)
  lastRenewedAt    DateTime?
  remindersSentCount Int     @default(0)
  quotaLimit       BigInt    @default(5000000)
  quotaWindowHours Int       @default(5)
  currentUsage     BigInt    @default(0)
  nextResetTime    DateTime
  status           String    @default("ACTIVE") // "ACTIVE" | "EXPIRING" | "EXPIRED" | "SUSPENDED" | "CANCELLED"
  notes            String?
  metadata         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  reminders        SubscriptionReminder[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([expiryTime])
  @@index([status])
}

model Plan {
  id                     String   @id @default(uuid())
  slug                   String?  @unique
  name                   String   @unique
  displayName            String
  tokenAllowance         BigInt   @default(20000000)
  tokenDisplay           String?
  windowHours            Int      @default(5)
  validityDays           Int      @default(30)
  rateLimitRpm           Int      @default(100)
  priceInr               Float    @default(4999)
  originalPriceInr       Float?
  currency               String   @default("INR")
  tagline                String?
  badge                  String?
  featuresJson           String?
  featured               Boolean  @default(false)
  enabled                Boolean  @default(true)
  sortOrder              Int      @default(0)
  status                 String   @default("active") // "active" | "archived"
  description            String?
  fulfillmentType        String   @default("AUTOMATIC") // "AUTOMATIC" | "MANUAL" | "HYBRID" | "NONE"
  isSubscription         Boolean  @default(true)
  durationDays           Int      @default(30)
  renewalDurationDays    Int      @default(30)
  autoFulfillEnabled     Boolean  @default(true)
  manualFulfillEnabled   Boolean  @default(false)
  requiresInventory      Boolean  @default(false)
  lowStockThreshold      Int      @default(5)
  activationInstructions String?
  trackExpiry            Boolean  @default(true)
  renewalRemindersEnabled Boolean @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  inventoryItems         InventoryItem[]
}

model Coupon {
  id                String        @id @default(uuid())
  code              String        @unique
  discountType      String        @default("PERCENTAGE") // "PERCENTAGE" | "FLAT_INR"
  discountValue     Float
  minOrderAmountInr Float         @default(0)
  maxDiscountInr    Float?
  applicablePlanIds String?       // JSON array or "ALL"
  maxUses           Int?
  usedCount         Int           @default(0)
  maxUsesPerUser    Int           @default(1)
  status            String        @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "DISABLED"
  expiresAt         DateTime?
  description       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  usages            CouponUsage[]
}

model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?
  discountAmount Float
  finalAmount    Float
  usedAt         DateTime @default(now())

  @@index([couponId, userId])
  @@index([userId])
}

model Model {

  id                String   @id @default(uuid())
  modelId           String   @unique
  displayName       String
  provider          String   // "Anthropic" | "OpenAI" | "Google" | "xAI" | "DeepSeek"
  description       String
  contextWindow     Int      @default(1000000)
  enabled           Boolean  @default(true)
  inputPrice        Float    @default(3.0)
  outputPrice       Float    @default(15.0)
  supportsStreaming Boolean  @default(true)
  supportsTools     Boolean  @default(true)
  supportsVision    Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminLog {
  id          String   @id @default(uuid())
  adminUserId String?
  adminUser   User?    @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String?
  metadata    String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Lead {
  id          String   @id @default(uuid())
  name        String
  email       String
  tokenAmount String
  useCase     String?
  message     String?
  status      String   @default("NEW") // "NEW" | "CONTACTED" | "QUOTED" | "CONVERTED" | "CLOSED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String
  category      String          @default("Technical issue") // "API issue" | "Payment" | "API key" | "Account" | "Technical issue" | "Other"
  status        String          @default("Open") // "Open" | "Awaiting Customer" | "Awaiting Support" | "Resolved" | "Closed"
  priority      String          @default("Normal") // "Low" | "Normal" | "High" | "Urgent"
  assignedAdmin String?
  messages      TicketMessage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole  String        @default("user") // "user" | "admin"
  content     String
  createdAt   DateTime      @default(now())
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  resendCount Int       @default(0)
  lastSentAt  DateTime  @default(now())
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
}

model PhoneOtpCode {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String
  otpHash     String
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  resendCount Int       @default(0)
  lastSentAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  otpHash   String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([otpHash])
  @@index([userId, expiresAt])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique
  ipAddress        String
  userAgent        String
  device           String
  location         String?
  isRevoked        Boolean   @default(false)
  expiresAt        DateTime
  lastActiveAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  ipAddress String?
  userAgent String?
  eventType String   // "REGISTER" | "EMAIL_VERIFICATION_SENT" | "EMAIL_VERIFIED" | "PHONE_OTP_SENT" | "PHONE_VERIFIED" | "LOGIN_SUCCESS" | "LOGIN_FAILED" | "LOGIN_LOCKED" | "LOGOUT" | "PASSWORD_RESET_REQUESTED" | "PASSWORD_RESET_COMPLETED" | "PASSWORD_CHANGED" | "SESSION_REVOKED" | "ADMIN_LOGIN_SUCCESS" | "ADMIN_LOGIN_FAILED" | "ACCOUNT_SUSPENDED"
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email])
  @@index([eventType])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // "info" | "success" | "warning" | "error"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AuditEvent {
  id              String    @id @default(uuid())
  timestamp       DateTime  @default(now())
  eventType       String    // e.g. "LOGIN_SUCCESS", "POSSIBLE_SQL_INJECTION_ATTEMPT", "ORDER_CREATED", etc.
  severity        String    @default("INFO") // "INFO" | "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  actorType       String    @default("SYSTEM") // "CUSTOMER" | "ADMIN" | "API_KEY" | "SYSTEM" | "ANONYMOUS" | "PAYMENT_PROVIDER" | "SUPPLIER"
  actorId         String?
  actorEmail      String?
  customerId      String?
  adminId         String?
  apiKeyId        String?
  sessionId       String?
  requestId       String?
  endpoint        String?
  httpMethod      String?
  resourceType    String?   // "USER" | "API_KEY" | "ORDER" | "SUBSCRIPTION" | "SUPPORT_TICKET" | "SUPPLIER" | "PLAN" | "SYSTEM"
  resourceId      String?
  action          String?
  result          String    @default("SUCCESS") // "SUCCESS" | "BLOCKED" | "FAILED" | "DENIED" | "WARNING"
  statusCode      Int?
  ipAddress       String?
  userAgent       String?
  country         String?
  metadata        String?   // Safe JSON metadata
  failureReason   String?
  beforeState     String?   // JSON snapshot before change
  afterState      String?   // JSON snapshot after change
  tamperHash      String?   // SHA-256 hash for tamper evidence
  previousHash    String?   // Previous record SHA-256 hash
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?

  @@index([timestamp])
  @@index([eventType])
  @@index([severity])
  @@index([actorType, actorId])
  @@index([customerId])
  @@index([adminId])
  @@index([apiKeyId])
  @@index([requestId])
  @@index([ipAddress])
  @@index([resourceType, resourceId])
  @@index([isResolved])
}

model CreditTransaction {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseId    String?
  purchase      Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  referralId    String?
  referral      Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  channel       String?   @default("WEBSITE") // "WEBSITE" | "WHATSAPP" | "MANUAL" | "OTHER"
  referenceId   String?
  type          String    // "PURCHASE_REWARD" | "REFERRAL_REWARD" | "CREDIT_REDEMPTION" | "MANUAL_CREDIT" | "MANUAL_DEBIT" | "REFUND_REVERSAL" | "ADMIN_ADJUSTMENT" | "CREDIT_EXPIRY"
  amount        Float     // Positive for credit added, negative for credit deducted
  balanceBefore Float
  balanceAfter  Float
  description   String
  reason        String?   // Mandatory reason for manual adjustments and reversals
  adminUserId   String?   // Admin who made manual adjustment
  status        String    @default("COMPLETED") // "COMPLETED" | "CANCELLED" | "PENDING"
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@index([orderId])
  @@index([purchaseId])
  @@index([referralId])
  @@index([createdAt])
}

model Purchase {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productName     String
  description     String?
  amountPaid      Float
  channel         String              @default("WHATSAPP") // "WEBSITE" | "WHATSAPP" | "MANUAL" | "OTHER"
  purchaseDate    DateTime            @default(now())
  status          String              @default("COMPLETED") // "COMPLETED" | "PENDING" | "CANCELLED" | "REFUNDED"
  creditsEarned   Float               @default(0)
  creditsRedeemed Float               @default(0)
  referenceId     String?             @unique
  notes           String?
  createdBy       String?             // Admin ID, "SYSTEM", "WHATSAPP_INTEGRATION", "PAYMENT_WEBHOOK"
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  creditTransactions CreditTransaction[]

  @@index([userId, purchaseDate])
  @@index([channel])
  @@index([status])
  @@index([referenceId])
  @@index([createdAt])
}

model RewardSettings {
  id                        String    @id @default("default")
  rewardPercentage          Float     @default(10.0) // 10%
  maxEligiblePurchaseAmount Float     @default(5000.0) // ₹5,000
  maxRewardPerTransaction   Float     @default(500.0) // ₹500
  currency                  String    @default("INR")
  isActive                  Boolean   @default(true)
  
  // Promotional Credit Multiplier & Flash Offer Configuration
  promoActive               Boolean   @default(false)
  promoMultiplier           Float     @default(2.0) // e.g. 2x
  promoMinPurchaseAmount    Float     @default(0.0) // 0 = all purchases qualify
  promoMaxCredits           Float     @default(1000.0) // e.g. max 1,000 credits
  promoTitle                String    @default("⚡ SUNDAY SPECIAL: 2X LIGHTNING CREDITS")
  promoSubtitle             String    @default("Get 2X credits on ALL purchases today (up to 1,000 credits max on purchases up to ₹5,000)!")
  promoBadge                String    @default("SUNDAY BOOST")
  promoShowPopup            Boolean   @default(true)
  promoShowBanner           Boolean   @default(true)
  promoEndsAt               DateTime?

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model SubscriptionReminder {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  reminderType   String       // "7_DAYS_BEFORE" | "3_DAYS_BEFORE" | "1_DAY_BEFORE" | "ON_EXPIRY"
  scheduledFor   DateTime
  sentAt         DateTime?
  status         String       @default("PENDING") // "PENDING" | "SENT" | "FAILED" | "CANCELLED"
  channel        String       @default("IN_APP") // "IN_APP" | "EMAIL" | "WHATSAPP"
  error          String?
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, reminderType])
  @@index([scheduledFor, status])
}

model InventoryItem {
  id              String    @id @default(uuid())
  planId          String
  plan            Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  sku             String?
  dataEncrypted   String    // Encrypted license key / credential
  displayValue    String    // Masked value
  status          String    @default("AVAILABLE") // "AVAILABLE" | "RESERVED" | "ASSIGNED" | "USED" | "EXPIRED" | "DISABLED"
  assignedOrderId String?
  assignedUserId  String?
  reservedAt      DateTime?
  usedAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([planId, status])
  @@index([assignedOrderId])
  @@index([assignedUserId])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled     Boolean  @default(true)
  whatsappEnabled  Boolean  @default(true)
  smsEnabled       Boolean  @default(false)
  inAppEnabled     Boolean  @default(true)
  renewalReminders Boolean  @default(true)
  orderUpdates     Boolean  @default(true)
  marketingUpdates Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model Referral {
  id                    String              @id @default(uuid())
  referrerId            String
  referrer              User                @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId        String?             @unique
  referredUser          User?               @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)
  referralCode          String
  referralSource        String?             @default("DIRECT_LINK") // "DIRECT_LINK" | "MANUAL_CODE" | "CAMPAIGN"
  status                String              @default("ATTRIBUTED") // "CLICKED" | "ATTRIBUTED" | "REGISTERED" | "QUALIFIED" | "REWARDED" | "REVERSED" | "DISQUALIFIED" | "EXPIRED" | "CANCELLED"
  riskStatus            String              @default("NORMAL") // "NORMAL" | "SUSPICIOUS" | "REVIEW_REQUIRED" | "DISQUALIFIED"
  riskReason            String?
  attributionStartedAt  DateTime            @default(now())
  attributionExpiresAt  DateTime
  registrationAt        DateTime?
  firstPurchaseAt       DateTime?
  qualifyingOrderId     String?
  qualifyingOrder       Order?              @relation(fields: [qualifyingOrderId], references: [id], onDelete: SetNull)
  rewardCreditsEarned   Float               @default(0)
  rewardStatus          String              @default("PENDING") // "PENDING" | "QUALIFIED" | "CREDITED" | "REVERSED" | "DISQUALIFIED"
  rewardCreditedAt      DateTime?
  rewardReversedAt      DateTime?
  reversalReason        String?
  ipAddress             String?
  userAgent             String?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  creditTransactions    CreditTransaction[]
  events                ReferralEvent[]

  @@index([referrerId])
  @@index([referralCode])
  @@index([status])
  @@index([rewardStatus])
  @@index([riskStatus])
  @@index([qualifyingOrderId])
  @@index([createdAt])
}

model ReferralClick {
  id              String   @id @default(uuid())
  referralCode    String
  referrerId      String
  ipAddress       String?
  userAgent       String?
  landingPage     String?
  converted       Boolean  @default(false)
  convertedUserId String?
  createdAt       DateTime @default(now())

  @@index([referralCode, createdAt])
  @@index([referrerId, createdAt])
}

model ReferralEvent {
  id         String   @id @default(uuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  eventType  String   // "REFERRAL_LINK_CLICKED" | "REFERRAL_ATTRIBUTED" | "REFERRED_CUSTOMER_REGISTERED" | "REFERRED_CUSTOMER_PURCHASED" | "REFERRAL_REWARD_QUALIFIED" | "REFERRAL_REWARD_CREDITED" | "REFERRAL_REWARD_REVERSED" | "REFERRAL_DISQUALIFIED" | "ADMIN_REVIEWED" | "ADMIN_STATUS_CHANGED"
  actorType  String   @default("SYSTEM") // "CUSTOMER" | "ADMIN" | "SYSTEM"
  actorId    String?
  metadata   String?  // JSON string
  createdAt  DateTime @default(now())

  @@index([referralId, createdAt])
  @@index([eventType])
}

model ReferralSettings {
  id                                   String   @id @default("default")
  enabled                              Boolean  @default(true)
  minPurchaseAmountInr                 Float    @default(500.0)
  attributionWindowDays                Int      @default(30)
  qualificationRule                    String   @default("FIRST_PURCHASE_ONLY") // "FIRST_PURCHASE_ONLY" | "EVERY_QUALIFYING_PURCHASE"
  rewardMethod                         String   @default("MATCH_PURCHASE_REWARD") // "MATCH_PURCHASE_REWARD" | "PERCENTAGE" | "FIXED_AMOUNT"
  customPercentage                     Float?   @default(10.0)
  customFixedAmount                    Float?   @default(100.0)
  maxRewardPerOrder                    Float    @default(500.0)
  allowExistingCustomerWithoutPurchase Boolean  @default(true)
  firstAttributionWins                 Boolean  @default(true)
  createdAt                            DateTime @default(now())
  updatedAt                            DateTime @updatedAt
}

model WhatsAppConversation {
  id                  String                    @id @default(uuid())
  customerId          String?
  customer            User?                     @relation("WhatsAppCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  whatsappNumber      String
  customerName        String?
  status              String                    @default("NEW") // "NEW" | "ACTIVE" | "WAITING_CUSTOMER" | "WAITING_ADMIN" | "PRICE_APPROVED" | "PAYMENT_PENDING" | "PAYMENT_VERIFIED" | "FULFILLMENT_PENDING" | "COMPLETED" | "CLOSED" | "HUMAN_HANDOFF"
  currentState        String                    @default("START") // "START" | "AWAITING_EMAIL" | "PRODUCT_SELECTION" | "AWAITING_ADMIN_PRICE" | "PAYMENT_PENDING" | "HUMAN_HANDOFF"
  currentProductId    String?
  currentProductName  String?
  currentOrderId      String?
  currentOrder        Order?                    @relation("ConversationActiveOrder", fields: [currentOrderId], references: [id], onDelete: SetNull)
  assignedAdminId     String?
  assignedAdmin       User?                     @relation("AssignedAdminWhatsApp", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  unreadCount         Int                       @default(0)
  lastMessageAt       DateTime                  @default(now())
  lastMessageSnippet  String?
  adminNotes          String?
  metadata            String?                   // JSON metadata for session attributes
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  messages            WhatsAppMessage[]
  negotiatedPrices    NegotiatedPrice[]
  orders              Order[]

  @@index([whatsappNumber])
  @@index([customerId])
  @@index([status])
  @@index([assignedAdminId])
  @@index([lastMessageAt])
}

model WhatsAppMessage {
  id                String               @id @default(uuid())
  conversationId    String
  conversation      WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         String               // "INBOUND" | "OUTBOUND"
  messageType       String               @default("TEXT") // "TEXT" | "INTERACTIVE" | "TEMPLATE" | "MEDIA" | "LOCATION" | "SYSTEM_NOTE"
  content           String
  providerMessageId String?              @unique
  deliveryStatus    String               @default("SENT") // "SENT" | "DELIVERED" | "READ" | "FAILED"
  sentBy            String?              // "CUSTOMER" | "BOT" | "ADMIN"
  senderId          String?              // Admin User ID if sentBy === "ADMIN"
  metadata          String?              // Safe JSON metadata
  createdAt         DateTime             @default(now())

  @@index([conversationId, createdAt])
  @@index([deliveryStatus])
}

model WhatsAppCustomerIdentity {
  id             String    @id @default(uuid())
  customerId     String
  customer       User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsappNumber String    @unique
  verified       Boolean   @default(true)
  verifiedAt     DateTime? @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([customerId])
  @@index([whatsappNumber])
}

model NegotiatedPrice {
  id                     String                @id @default(uuid())
  customerId             String
  customer               User                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsappConversationId String?
  whatsappConversation   WhatsAppConversation? @relation(fields: [whatsappConversationId], references: [id], onDelete: SetNull)
  productId              String
  productName            String
  amount                 Float
  currency               String                @default("INR")
  createdBy              String                // admin userId
  expiresAt              DateTime
  status                 String                @default("ACTIVE") // "ACTIVE" | "USED" | "EXPIRED" | "CANCELLED"
  orderId                String?               @unique
  order                  Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  notes                  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([customerId, status])
  @@index([productId])
  @@index([whatsappConversationId])
  @@index([createdBy])
  @@index([expiresAt])
}

